{
    "openapi": "3.0.0",
    "info": {
        "title": "Encryption API",
        "description": "POC Symmetric (AES-256) & Asymmetric (RSA 2048) encryption with personal data storage",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8001",
            "description": "Local dev"
        }
    ],
    "paths": {
        "/api/asymmetric/generate-keys": {
            "post": {
                "summary": "Generate RSA 2048 key pair and save to storage/app/keys/",
                "operationId": "fb86f1d1b4e8073bf02ad632dabae8c8",
                "responses": {
                    "200": {
                        "description": "Keys generated and saved",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Key pair generated and saved to storage/app/keys"
                                        },
                                        "data": {
                                            "properties": {
                                                "generated": {
                                                    "type": "boolean",
                                                    "example": true
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Key generation failed"
                    }
                }
            }
        },
        "/api/asymmetric/encrypt": {
            "post": {
                "summary": "Encrypt using public key from storage/app/keys/public.pem",
                "operationId": "1a91dafeaef82a85fdb2534dd846c00d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "text"
                                ],
                                "properties": {
                                    "text": {
                                        "type": "string",
                                        "example": "secret message"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Encrypted successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Encrypted with public key from storage"
                                        },
                                        "data": {
                                            "properties": {
                                                "ciphertext": {
                                                    "type": "string",
                                                    "example": "base64encoded..."
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Keys not generated or encryption failed"
                    }
                }
            }
        },
        "/api/asymmetric/decrypt": {
            "post": {
                "summary": "Decrypt using private key from storage/app/keys/private.pem",
                "operationId": "acfaf8364cc63f111d4b68efecf0054a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "ciphertext"
                                ],
                                "properties": {
                                    "ciphertext": {
                                        "type": "string",
                                        "example": "base64encoded..."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Decrypted successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Decrypted with private key from storage"
                                        },
                                        "data": {
                                            "properties": {
                                                "plaintext": {
                                                    "type": "string",
                                                    "example": "secret message"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Keys not generated or decryption failed"
                    }
                }
            }
        },
        "/api/personal-data": {
            "get": {
                "summary": "List all personal data (decrypted)",
                "operationId": "952c4f09e5ad5f31f7d76a865de44a27",
                "responses": {
                    "200": {
                        "description": "List of personal data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "OK"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Encrypt and store personal data (full_name, nik, phone_number)",
                "operationId": "ffb3969857788e6f4ddf21f9d89b7a56",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "full_name",
                                    "nik",
                                    "phone_number"
                                ],
                                "properties": {
                                    "full_name": {
                                        "type": "string",
                                        "example": "Budi Santoso"
                                    },
                                    "nik": {
                                        "type": "string",
                                        "example": "3273010101010001"
                                    },
                                    "phone_number": {
                                        "type": "string",
                                        "example": "08123456789"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Stored successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string"
                                        },
                                        "data": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/personal-data/{id}": {
            "get": {
                "summary": "Get personal data detail by ID (decrypted)",
                "operationId": "8c72c8f5b2a9328d16f161b33691a2b8",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Record ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Data found"
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            }
        },
        "/api/symmetric/encrypt": {
            "post": {
                "summary": "Encrypt plaintext using AES-256-CBC",
                "operationId": "74d32d163a21a407ce5e47d2f2fb7133",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "text"
                                ],
                                "properties": {
                                    "text": {
                                        "type": "string",
                                        "example": "sensitive data"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Encrypted successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Encrypted"
                                        },
                                        "data": {
                                            "properties": {
                                                "ciphertext": {
                                                    "type": "string",
                                                    "example": "eyJpdiI6I..."
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Encryption failed"
                    }
                }
            }
        },
        "/api/symmetric/decrypt": {
            "post": {
                "summary": "Decrypt ciphertext using AES-256-CBC",
                "operationId": "2de5d51537f9c7b013d58862567e6131",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "ciphertext"
                                ],
                                "properties": {
                                    "ciphertext": {
                                        "type": "string",
                                        "example": "eyJpdiI6I..."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Decrypted successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Decrypted"
                                        },
                                        "data": {
                                            "properties": {
                                                "plaintext": {
                                                    "type": "string",
                                                    "example": "sensitive data"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid ciphertext or decryption failed"
                    }
                }
            }
        }
    }
}