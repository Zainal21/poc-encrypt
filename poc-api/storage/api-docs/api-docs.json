{
    "openapi": "3.0.0",
    "info": {
        "title": "Encryption POC API",
        "description": "Simulasi symmetric & asymmetric encryption. Client menyimpan key dan mengirim payload terenkripsi (key, content).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8001",
            "description": "Local"
        }
    ],
    "paths": {
        "/api/crypto/server-public-key": {
            "get": {
                "tags": [
                    "Crypto"
                ],
                "summary": "Ambil public key server (untuk enkripsi transport key/content dari client)",
                "operationId": "448e753a4ae2fbdbbdaf06a1df5b8114",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/crypto/keys/register": {
            "post": {
                "tags": [
                    "Crypto"
                ],
                "summary": "Daftarkan public key (asymmetric) milik client ke API",
                "operationId": "635cb9caf20adfad5a13ff428a940215",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "public_key"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "public_key": {
                                        "description": "PEM public key",
                                        "type": "string"
                                    },
                                    "private_key": {
                                        "description": "Opsional (demo simulasi decrypt di API)",
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registered"
                    }
                }
            }
        },
        "/api/personal-data/symmetric": {
            "get": {
                "tags": [
                    "PersonalData"
                ],
                "summary": "List personal data symmetric (ciphertext)",
                "operationId": "dcd3cccaaf7ce38a442bfdd072662f4f",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            },
            "post": {
                "tags": [
                    "PersonalData"
                ],
                "summary": "Simpan personal data (symmetric). Payload terenkripsi: key & content.",
                "operationId": "e2cfc4557894e1b1f71d38a2d4b03ebb",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "key",
                                    "content"
                                ],
                                "properties": {
                                    "key": {
                                        "description": "AES key (base64 32B) terenkripsi RSA dengan server public key",
                                        "type": "string"
                                    },
                                    "content": {
                                        "description": "JSON personal data terenkripsi AES-256-CBC dengan key tersebut (base64 iv+cipher)",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Stored"
                    }
                }
            }
        },
        "/api/personal-data/asymmetric": {
            "get": {
                "tags": [
                    "PersonalData"
                ],
                "summary": "List personal data asymmetric (decrypted untuk demo, butuh private key tersimpan)",
                "operationId": "5802a2899d3b481c6d51970f612dd056",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            },
            "post": {
                "tags": [
                    "PersonalData"
                ],
                "summary": "Simpan personal data (asymmetric hybrid). Payload terenkripsi: key & content.",
                "operationId": "9f2927486c51ecdacc21be84dc5c64ec",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "key",
                                    "content"
                                ],
                                "properties": {
                                    "key": {
                                        "description": "key_id terdaftar terenkripsi RSA dengan server public key (transport)",
                                        "type": "string"
                                    },
                                    "content": {
                                        "description": "JSON {key, content}: AES key dienkripsi RSA public key client, data dienkripsi AES key tsb",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Stored"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Crypto",
            "description": "Crypto"
        },
        {
            "name": "PersonalData",
            "description": "PersonalData"
        }
    ]
}